// Configuração do Cloudflare Worker (docs/etapas/18-cloudflare.md)
{
  "name": "prumo",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // A API passa pelo Worker; o resto é servido direto como arquivo estático
    "run_worker_first": ["/api/*"]
  },
  // Domínio próprio: a Cloudflare cria o DNS e o certificado (o endereço *.workers.dev continua ativo)
  "routes": [{ "pattern": "prumo.jardimdofazer.com.br", "custom_domain": true }],
  // Logs no painel da Cloudflare (inclui as denúncias de resposta do coach)
  "observability": { "enabled": true }
  // Variáveis da IA: configure como SECRETS, nunca aqui
  // (LLM_PROVIDER, LLM_API_KEY, LLM_MODEL, LLM_BASE_URL — ver .env.example)
}
