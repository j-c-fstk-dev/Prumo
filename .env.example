# ============================================================
# Coach de IA: escolha UM provedor. Sem configuração, o coach
# responde em modo offline com mensagens prontas.
# ============================================================

# gemini | anthropic | openai  (openai = qualquer API compatível com OpenAI)
LLM_PROVIDER="gemini"
LLM_API_KEY="MY_LLM_API_KEY"

# Opcional: id do modelo. Padrões: gemini-3.8-flash | claude-haiku-5-5 | glm-5.1
# Z.ai: LLM_PROVIDER="openai", LLM_BASE_URL="https://api.z.ai/api/paas/v4", LLM_MODEL="glm-4.5-flash" (grátis)
# LLM_MODEL=""

# Só para LLM_PROVIDER=openai: URL base da API compatível. Exemplos:
#   Z.ai (GLM):  https://api.z.ai/api/paas/v4
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama local: http://localhost:11434/v1
# LLM_BASE_URL=""

# Opcional: JSON com campos extras para o provedor. Z.ai sem raciocínio (mais rápido e barato):
# LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# Porta do servidor (padrão: 3000)
# PORT=3000

# Paywall (freemium). Desligado no MVP: todo mundo tem acesso completo.
# Ligado, os primeiros 30 dias de cada pessoa são Premium de fundador.
VITE_PAYWALL_ENABLED=false
